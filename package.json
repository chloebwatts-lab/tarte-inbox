{
  "name": "tarte-inbox",
  "version": "0.0.1",
  "private": true,
  "description": "Background email automation for hello@tarte.com.au — triage, drafting, calendar, Xero invoicing.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tick": "tsx src/scripts/tick.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "googleapis": "^144.0.0",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "pg": "^8.20.0",
    "xero-node": "^9.0.0",
    "zod": "^4.3.6",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
