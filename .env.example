# --- HTTP server ---
PORT=8787
PUBLIC_BASE_URL=https://inbox.tarte.com.au

# --- Database (shared with tarte-kitchen Postgres) ---
DATABASE_URL=postgres://user:pass@host:5432/tarte

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Gmail (hello@tarte.com.au) ---
# OAuth client for the workspace-owned app. Scopes needed:
#   gmail.modify (labels + read + drafts), gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://inbox.tarte.com.au/oauth/gmail/callback
HELLO_MAILBOX=hello@tarte.com.au

# --- Google Calendar ---
# Same OAuth client as Gmail (added scopes: calendar.events).
TEA_GARDEN_CALENDAR_ID=
BEACH_HOUSE_CALENDAR_ID=

# --- Xero (Tarte Currumbin Pty Ltd) ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://inbox.tarte.com.au/oauth/xero/callback

# --- Scheduler ---
TICK_INTERVAL_SECONDS=120

# --- Behaviour flags ---
# Set to 'false' to force all replies to draft (no auto-send) — launch posture.
ENABLE_AUTO_SEND=false
